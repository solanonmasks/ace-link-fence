---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';

const field = 'font-size:18px;padding:16px;border:2px solid #3A4854;background:#23303A;color:#EEF1F3';
const label = 'display:flex;flex-direction:column;gap:8px;font-weight:600';

const propertyTypes = ['Residential', 'Commercial', 'Industrial or job site', 'Strata'];
const needs = [
  'Chain link fence',
  'Gate (cantilever, swing or custom)',
  'Steel or ornamental fence',
  'Cladding or privacy fence',
  'Sport court or pool fence',
  'Welded handrails',
  'Security (bollards, razor wire)',
  'Emergency repair',
];

const areaText = site.serviceAreas.slice(0, -1).join(', ') + ' and ' + site.serviceAreas.at(-1);
---
<Base
  title="Get a Quote | Ace Link Fence Ltd."
  description="Request a free fencing quote from Ace Link Fence Ltd. Call 604-825-8777 or send your project details and we'll call to schedule an appointment."
  current="contact"
  showCta={false}
>
<main data-screen-label="Contact">
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) clamp(64px,8vw,112px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px 80px;align-items:start">
    <div>
      <h1 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(60px,7.4vw,128px);line-height:0.88;text-transform:uppercase;margin:0 0 18px">Get a quote</h1>
      <p style="margin:0 0 32px;font-size:20px;color:#C7D0D6">Tell us about your project idea and we’ll call to schedule an appointment.</p>

      <form id="quote-form" action={site.formEndpoint} method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px">
        <label style={label}>Name<input required name="name" autocomplete="name" style={field} /></label>
        <label style={label}>Phone<input required type="tel" name="phone" autocomplete="tel" style={field} /></label>
        <label style={label}>Email<input type="email" name="email" autocomplete="email" style={field} /></label>
        <label style={label}>Property type
          <select name="type" style={field}>{propertyTypes.map((o) => <option>{o}</option>)}</select></label>
        <label style={label}>What do you need?
          <select name="need" style={field}>{needs.map((o) => <option>{o}</option>)}</select></label>
        <label style={label}>City<input name="city" autocomplete="address-level2" style={field} /></label>
        <label style={`grid-column:1/-1;${label}`}>Project details
          <textarea name="desc" rows="5" placeholder="About 220 ft of 8 ft chain link around a Langley yard, with a 24 ft cantilever gate at the entrance." style={`${field};resize:vertical;line-height:1.5`}></textarea></label>
        <p id="form-error" role="alert" hidden style="grid-column:1/-1;margin:0;padding:14px 16px;background:#3A2226;border-left:4px solid #E5484D;color:#FFDADC">Sorry, your request didn’t send. Please try again, or call us at <a href={`tel:${site.phone.tel}`} style="color:#FFFFFF">{site.phone.display}</a>.</p>
        <div style="grid-column:1/-1"><button type="submit" class="btn-yellow" style="color:#1A2229;font-family:'Oswald',sans-serif;font-weight:700;font-size:21px;text-transform:uppercase;padding:18px 34px;border:none;cursor:pointer">Send request</button></div>
      </form>

      <div id="form-thanks" hidden style="background:#F2C230;color:#1A2229;padding:clamp(28px,4vw,48px);display:flex;flex-direction:column;gap:12px">
        <h2 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:52px;line-height:1;text-transform:uppercase;margin:0">Request received.</h2>
        <p style="margin:0;font-weight:500">We’ll call to schedule an appointment. For an emergency, call {site.phone.display}.</p>
        <div><button id="form-reset" type="button" style="background:#1A2229;color:#EEF1F3;border:none;font-weight:600;font-size:16px;padding:12px 20px;cursor:pointer">Send another</button></div>
      </div>
    </div>

    <aside style="background:#23303A;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:24px;border-top:6px solid #F2C230">
      <div><span style="font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:14px;color:#F2C230">CALL US</span><a href={`tel:${site.phone.tel}`} style="display:block;font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(52px,5.4vw,84px);line-height:1;color:#FFFFFF;text-decoration:none;margin-top:4px">{site.phone.display}</a></div>
      <div><strong style="display:block">Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div><strong style="display:block">Service area</strong>{areaText}</div>
    </aside>
  </section>
</main>
</Base>


<script is:inline>
  // Sends the form to Formspree in the background, then shows the thank-you box.
  (function () {
    var form = document.getElementById('quote-form');
    var thanks = document.getElementById('form-thanks');
    var error = document.getElementById('form-error');
    var reset = document.getElementById('form-reset');
    if (!form) return;
    var button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      error.hidden = true;
      button.disabled = true;
      button.textContent = 'Sending…';
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Request failed');
          form.reset();
          form.hidden = true;
          thanks.hidden = false;
          window.scrollTo(0, 0);
        })
        .catch(function () {
          error.hidden = false;
        })
        .finally(function () {
          button.disabled = false;
          button.textContent = 'Send request';
        });
    });

    reset.addEventListener('click', function () {
      thanks.hidden = true;
      form.hidden = false;
    });
  })();
</script>
