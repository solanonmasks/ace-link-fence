---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/site.js';
---
<Base
  title="Projects | Ace Link Fence Ltd."
  description="Chain link, steel, gate, enclosure and security fencing projects by Ace Link Fence Ltd. across Surrey and the Lower Mainland."
  current="work"
>
<main data-screen-label="Gallery">
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) 40px">
    <h1 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(64px,8vw,148px);line-height:0.88;text-transform:uppercase;margin:0">Projects</h1>
  </section>
  <section style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(64px,8vw,112px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:8px">
      {gallery.map((src, i) => (
        <div style="aspect-ratio:4/3;overflow:hidden;background:#23303A"><img src={src} alt={`Ace Link Fence project photo ${i + 1}`} loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
      ))}
    </div>
  </section>
</main>
</Base>
