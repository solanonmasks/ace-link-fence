---
import Base from '../layouts/Base.astro';
import { site, images, services } from '../data/site.js';

const tel = `tel:${site.phone.tel}`;

const awards = [
  { big: 'Best of 2019', small: 'TrustedPros.ca', pad: '26px 24px 26px 0', border: true },
  { big: 'Top 3 · 2023', small: 'Fencing contractors in Surrey', pad: '26px 24px', border: true },
  { big: 'Res + Com', small: 'Homes, businesses, job sites', pad: '26px 24px', border: true },
  { big: 'Emergency', small: 'Repairs when it can’t wait', pad: '26px 0 26px 24px', border: false },
];

const perks = ['Professional crews', 'Certified experience', 'Competitive prices', 'Welding in-house'];

const steps = [
  { n: '01', title: 'Call or send the form', text: 'Tell us the property, the fence and the timeline.' },
  { n: '02', title: 'On-site measure', text: 'We check the line, grade and access, and recommend the right system.' },
  { n: '03', title: 'Fixed quote', text: 'Materials, gates, footage and install dates in writing.' },
  { n: '04', title: 'Install and weld', text: 'Our crew sets posts, hangs fabric and welds gates on site.' },
];
---
<Base
  title="Ace Link Fence Ltd. | Chain link, steel and security fencing in Surrey and the Lower Mainland"
  description="Family-owned Surrey fencing company. Chain link, steel, cladding and ornamental fences, gates, sport courts, welded handrails and security fencing. Residential, commercial and emergency repair."
  current="home"
>
<main data-screen-label="Home">
  <section style="position:relative;min-height:max(620px,calc(100vh - 122px));display:flex;align-items:flex-end;overflow:hidden">
    <img src={images.hero} alt="Commercial chain link fence and gate" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,34,41,0.25) 0%,rgba(26,34,41,0.55) 45%,rgba(26,34,41,0.96) 100%)"></div>
    <div style="position:relative;max-width:1440px;width:100%;margin:0 auto;padding:80px clamp(20px,4vw,56px) clamp(40px,5vw,72px)">
      <span style="font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:14px;color:#F2C230">CHAIN LINK · STEEL · SECURITY · GATES</span>
      <h1 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(64px,9vw,168px);line-height:0.88;text-transform:uppercase;margin:14px 0 0;color:#FFFFFF;max-width:9em">Fences that <span style="color:#F2C230">hold the line.</span></h1>
      <div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:24px 56px;align-items:flex-end;justify-content:space-between">
        <p style="margin:0;max-width:34em;font-size:clamp(18px,1.5vw,21px);color:#DCE2E6">Chain link, steel, cladding and ornamental fences, cantilever and custom gates, sport court and pool enclosures. Installed and repaired for homes, businesses and job sites across the Lower Mainland.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a href="/contact" class="btn-yellow" style="color:#1A2229;font-family:'Oswald',sans-serif;font-weight:700;font-size:21px;text-transform:uppercase;padding:18px 30px;text-decoration:none;white-space:nowrap">Get a Free Quote</a>
          <a href={tel} class="btn-outline" style="border:2px solid #EEF1F3;color:#FFFFFF;font-family:'Oswald',sans-serif;font-weight:700;font-size:21px;text-transform:uppercase;padding:16px 28px;text-decoration:none;white-space:nowrap">{site.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <section style="border-bottom:1px solid #2F3B45">
    <div style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">
      {awards.map((a) => (
        <div style={`padding:${a.pad};${a.border ? 'border-right:1px solid #2F3B45' : ''}`}><span style="display:block;font-family:'Oswald',sans-serif;font-weight:700;font-size:40px;line-height:1;color:#F2C230">{a.big}</span>{a.small}</div>
      ))}
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px 60px;margin-bottom:clamp(32px,4vw,52px)">
      <h2 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(52px,6vw,108px);line-height:0.9;text-transform:uppercase;margin:0">What we <span style="color:#F2C230">install</span></h2>
      <p style="margin:0;max-width:28em;color:#C7D0D6">From a backyard dog run to a gated industrial yard. We help you pick the right fence for the job and the budget.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px">
      {services.map((s) => (
        <a href="/projects" style="position:relative;display:block;aspect-ratio:4/3;overflow:hidden;color:#FFFFFF;text-decoration:none;background:#23303A">
          <img src={s.img} alt={s.title} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,34,41,0) 35%,rgba(26,34,41,0.94) 100%)"></div>
          <span style="position:absolute;top:14px;left:16px;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:13px;color:#1A2229;background:#F2C230;padding:3px 8px">{s.tag}</span>
          <div style="position:absolute;left:0;right:0;bottom:0;padding:20px 22px">
            <h3 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;line-height:1;text-transform:uppercase;margin:0">{s.title}</h3>
            <p style="margin:6px 0 0;color:#DCE2E6;font-size:16px">{s.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section style="background:#F2C230;color:#1A2229">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:28px 80px;align-items:center">
      <div>
        <h2 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(52px,6vw,108px);line-height:0.9;text-transform:uppercase;margin:0">Fence down? Gate jammed?</h2>
        <p style="margin:18px 0 0;font-size:20px;max-width:28em;font-weight:500">Vehicle damage, storm damage, a break-in or a gate that won’t close. Call and we’ll get your property secure again.</p>
      </div>
      <a href={tel} class="call-block" style="display:block;color:#FFFFFF;text-decoration:none;padding:clamp(24px,3vw,40px)">
        <span style="display:block;font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:14px;color:#F2C230">EMERGENCY REPAIR LINE</span>
        <span style="display:block;font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(52px,5.8vw,96px);line-height:1.05">{site.phone.display}</span>
      </a>
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 96px;align-items:center">
    <div style="aspect-ratio:4/3;overflow:hidden"><img src={images.family} alt="Ace Link Fence crew installing a fence" loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
    <div style="display:flex;flex-direction:column;gap:20px">
      <h2 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(44px,5vw,84px);line-height:0.92;text-transform:uppercase;margin:0">Family-owned. <span style="color:#F2C230">Built to spec.</span></h2>
      <p style="margin:0;color:#C7D0D6">Ace Link Fence is a family business serving Surrey and every Lower Mainland city. We work with homeowners, property managers, builders and businesses, and we’ll tell you straight which fence fits your property and budget.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#2F3B45;border:1px solid #2F3B45">
        {perks.map((p) => <span style="background:#1A2229;padding:16px 18px;font-weight:600">{p}</span>)}
      </div>
    </div>
  </section>

  <section style="background:#23303A;color:#EEF1F3">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px)">
      <h2 style="font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;font-size:clamp(44px,5vw,84px);line-height:0.95;letter-spacing:-0.02em;margin:0 0 clamp(28px,3vw,44px)">How a job <span style="color:#F2C230">runs</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:0 32px">
        {steps.map((s) => (
          <div style="border-top:3px solid #F2C230;padding-top:18px;margin-bottom:24px"><span style="display:block;font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;font-size:44px;line-height:1;color:#F2C230">{s.n}</span><h3 style="font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;font-size:26px;line-height:1.1;margin:10px 0 6px">{s.title}</h3><p style="margin:0;color:#C7D0D6;font-size:17px">{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:#1A2229;color:#EEF1F3">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:28px 80px;align-items:start">
      <h2 style="font-family:'Oswald',sans-serif;font-weight:700;text-transform:uppercase;font-size:clamp(40px,4.4vw,72px);line-height:0.95;letter-spacing:-0.02em;margin:0">Where we work</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px 28px;font-size:20px;font-weight:600">
        {site.serviceAreas.map((c) => <span style="border-bottom:3px solid #F2C230;padding-bottom:4px">{c}</span>)}
        <span style="flex-basis:100%;font-size:17px;font-weight:400;color:#C7D0D6;margin-top:6px">Not on the list? Call anyway. If we can get there, we will.</span>
      </div>
    </div>
  </section>
</main>
</Base>
